# Copy to .env and fill in. Never commit .env.

# Postgres connection string (Supabase: Project Settings > Database > Connection pooling, port 6543).
# Leave empty locally to use the built-in database stored in ./data
DATABASE_URL=

# 32+ random characters. Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Set to production on the live server (secure cookies, HTTPS-only headers).
NODE_ENV=development
PORT=3000

# Behind a host/proxy that terminates HTTPS (Render, Railway, Fly, Nginx): 1
TRUST_PROXY=

# Optional: create the first admin automatically on first start, then remove these two lines.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Max orders per visitor per 10 minutes (spam protection).
ORDER_RATE_LIMIT=8
